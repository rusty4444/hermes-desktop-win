<Window
    x:Class="HermesDesktop.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HermesDesktop.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Hermes Desktop"
    Width="1200"
    Height="800"
    MinWidth="800"
    MinHeight="600">

    <Grid>
        <NavigationView x:Name="NavView"
                        IsPaneOpen="True"
                        DisplayModeChanged="NavView_DisplayModeChanged"
                        ItemInvoked="NavView_ItemInvoked"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewItem"
                                    Content="Overview"
                                    Icon="Home"
                                    Tag="overview"/>
                <NavigationViewItem x:Name="ChatItem"
                                    Content="Chat"
                                    Icon="Message"
                                    Tag="chat"/>
                <NavigationViewItem x:Name="SessionsItem"
                                    Content="Sessions"
                                    Icon="Chat"
                                    Tag="sessions"/>
                <NavigationViewItem x:Name="WorkflowsItem"
                                    Content="Workflows"
                                    Icon="Repeat"
                                    Tag="workflows"/>
                <NavigationViewItem x:Name="CronJobsItem"
                                    Content="Cron Jobs"
                                    Icon="Calendar"
                                    Tag="cronjobs"/>
                <NavigationViewItem x:Name="KanbanItem"
                                    Content="Kanban"
                                    Icon="Preview"
                                    Tag="kanban"/>
                <NavigationViewItem x:Name="FilesItem"
                                    Content="Files"
                                    Icon="Folder"
                                    Tag="files"/>
                <NavigationViewItem x:Name="UsageItem"
                                    Content="Usage"
                                    Icon="Chart"
                                    Tag="usage"/>
                <NavigationViewItem x:Name="SkillsItem"
                                    Content="Skills"
                                    Icon="Library"
                                    Tag="skills"/>
                <NavigationViewItem x:Name="TerminalItem"
                                    Content="Terminal"
                                    Icon="Console"
                                    Tag="terminal"/>
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Frame x:Name="ContentFrame"/>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
