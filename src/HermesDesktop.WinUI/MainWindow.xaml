<Window
    x:Class="HermesDesktop.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HermesDesktop.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Hermes Desktop">

    <Grid>
        <NavigationView x:Name="NavView"
                        IsPaneOpen="True"
                        DisplayModeChanged="NavView_DisplayModeChanged"
                        ItemInvoked="NavView_ItemInvoked"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewItem"
                                    Content="Overview"
                                    Tag="overview">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ChatItem"
                                    Content="Chat"
                                    Tag="chat">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Message"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SessionsItem"
                                    Content="Sessions"
                                    Tag="sessions">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Comment"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WorkflowsItem"
                                    Content="Workflows"
                                    Tag="workflows">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="RepeatAll"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CronJobsItem"
                                    Content="Cron Jobs"
                                    Tag="cronjobs">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Calendar"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="KanbanItem"
                                    Content="Kanban"
                                    Tag="kanban">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Preview"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="FilesItem"
                                    Content="Files"
                                    Tag="files">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="UsageItem"
                                    Content="Usage"
                                    Tag="usage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="BarChart4"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SkillsItem"
                                    Content="Skills"
                                    Tag="skills">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TerminalItem"
                                    Content="Terminal"
                                    Tag="terminal">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="CommandPrompt"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Frame x:Name="ContentFrame"/>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
