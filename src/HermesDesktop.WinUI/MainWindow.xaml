<Window
    x:Class="HermesDesktop.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Hermes Desktop">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="NavList" Grid.Column="0"
                 SelectionChanged="NavList_SelectionChanged">
            <ListBoxItem Content="Overview" Tag="overview"/>
            <ListBoxItem Content="Chat" Tag="chat"/>
            <ListBoxItem Content="Sessions" Tag="sessions"/>
            <ListBoxItem Content="Files" Tag="files"/>
            <ListBoxItem Content="Settings" Tag="settings"/>
        </ListBox>
        <Frame x:Name="ContentFrame" Grid.Column="1"/>
    </Grid>
</Window>
