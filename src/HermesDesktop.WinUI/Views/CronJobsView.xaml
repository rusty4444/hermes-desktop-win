<Page
    x:Class="HermesDesktop.WinUI.Views.CronJobsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:HermesDesktop.WinUI.ViewModels"
    xmlns:models="using:HermesDesktop.WinUI.Models"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewmodels:CronJobsViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="20">
            <TextBlock Text="Cron Jobs" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,10"/>
            <Button Content="Refresh" Click="RefreshButton_Click" Margin="12,0,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="20">
            <StackPanel>
                <!-- Jobs List -->
                <Border BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Scheduled Jobs" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>
                        <ListView ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedJob, Mode=TwoWay}"
                                  Margin="0,0,0,8">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CronJobInfo">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{x:Bind ScheduleExpr}" Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{x:Bind StateDisplay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlDisabledBaseMediumBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Prompt}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemControlDisabledBaseMediumBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Content="Run" Click="RunButton_Click" Tag="{x:Bind Id}" FontSize="12" Padding="4,2"/>
                                            <Button Content="Pause" Click="PauseButton_Click" Tag="{x:Bind Id}" FontSize="12" Padding="4,2"
                                                    Visibility="{x:Bind Enabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="Resume" Click="ResumeButton_Click" Tag="{x:Bind Id}" FontSize="12" Padding="4,2"
                                                    Visibility="{x:Bind Enabled, Converter={StaticResource InvertBoolToVisibilityConverter}}"/>
                                            <Button Content="Delete" Click="DeleteButton_Click" Tag="{x:Bind Id}" FontSize="12" Padding="4,2"
                                                    Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Status -->
                <Border BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                   Visibility="{x:Bind ViewModel.ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBlock Text="Loading..." Margin="0,0,0,4"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ProgressBar IsIndeterminate="True" Margin="0,0,0,4"
                                     Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
