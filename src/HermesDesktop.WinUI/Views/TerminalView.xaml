<Page
    x:Class="HermesDesktop.WinUI.Views.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="20" Grid.Row="0">
            <TextBlock Text="Terminal" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,10"/>
            <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click"
                    Margin="12,0,8,0"/>
            <Button x:Name="DisconnectButton" Content="Disconnect" Click="DisconnectButton_Click"
                    IsEnabled="False" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText" Text="Disconnected"
                       Foreground="{ThemeResource SystemControlDisabledBaseMediumBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Terminal Output -->
        <Border Grid.Row="1" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1" CornerRadius="4" Margin="20,0,20,12"
                Background="#FF1E1E1E">
            <ScrollViewer x:Name="TerminalOutputScroller"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TerminalOutput"
                           FontFamily="Consolas"
                           FontSize="13"
                           Foreground="#FFD4D4D4"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           Margin="12"/>
            </ScrollViewer>
        </Border>

        <!-- Input Area -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommandInput"
                     PlaceholderText="Enter command..."
                     FontFamily="Consolas"
                     FontSize="13"
                     IsEnabled="False"
                     KeyDown="CommandInput_KeyDown"
                     Grid.Column="0"
                     Margin="0,0,8,0"/>
            <Button x:Name="SendButton" Content="Send"
                    Click="SendButton_Click"
                    IsEnabled="False"
                    Grid.Column="1"/>
        </Grid>

        <!-- Loading indicator -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True"
                     Visibility="Collapsed"
                     x:Name="ConnectingSpinner"
                     Margin="20,0,20,12"
                     Width="200"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
    </Grid>
</Page>
