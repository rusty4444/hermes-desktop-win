<Page
    x:Class="HermesDesktop.WinUI.Views.FilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HermesDesktop.WinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:HermesDesktop.WinUI.ViewModels"
    xmlns:models="using:HermesDesktop.WinUI.Models"
    xmlns:converters="using:HermesDesktop.WinUI.Converters"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewmodels:FilesViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:DateTimeToStringConverter x:Key="DateTimeToStringConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="20">
            <TextBlock Text="Files" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Margin="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- File Browser -->
                <Border Grid.Column="0" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Path Bar -->
                        <StackPanel Orientation="Horizontal" Margin="12,8,12,0" Grid.Row="0">
                            <Button Content="Up" Click="UpButton_Click" Margin="0,0,8,0"/>
                            <TextBox x:Name="PathTextBox" Text="{x:Bind ViewModel.CurrentPath, Mode=TwoWay}" 
                                     KeyDown="PathTextBox_KeyDown" Width="300" Margin="0,0,8,0"/>
                            <Button Content="Go" Click="GoButton_Click" Margin="0,0,0,0"/>
                        </StackPanel>

                        <!-- Toolbar -->
                        <StackPanel Orientation="Horizontal" Margin="12,0,12,8" Grid.Row="1" Spacing="8">
                            <Button Content="New File" Click="NewFile_Click"/>
                            <Button Content="Delete" Click="Delete_Click"/>
                        </StackPanel>

                        <!-- File List -->
                        <ListView Grid.Row="2"
                                  ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                                  SelectionChanged="FileList_SelectionChanged"
                                  Margin="12,0,12,12">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileItem">
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                        <SymbolIcon Symbol="{x:Bind IsDirectory, Converter={StaticResource BoolToSymbolConverter}}" 
                                                    Margin="0,0,8,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind FullPath}" Style="{ThemeResource CaptionTextBlockStyle}" 
                                                       Foreground="{ThemeResource SystemControlDisabledBaseMediumBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- File Editor -->
                <Border Grid.Column="1" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Editor Header -->
                        <Border Grid.Row="0" Background="{ThemeResource SystemControlAcrylicElementBrush}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FileNameText" Text="Select a file to view/edit" 
                                           Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="8" Margin="0,0,12,0">
                                    <Button Content="Save" Click="Save_Click"/>
                                    <Button Content="Reload" Click="Reload_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Editor Content -->
                        <ScrollViewer Grid.Row="1" Margin="12">
                            <TextBox x:Name="ContentTextBox" 
                                     Text="{x:Bind ViewModel.FileContent, Mode=TwoWay}"
                                     AcceptsReturn="True" 
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     Margin="0,0,0,12"/>
                        </ScrollViewer>

                        <!-- Status and Actions -->
                        <Grid Grid.Row="2" Margin="12,0,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.ErrorMessage}" 
                                           TextWrapping="Wrap" 
                                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" 
                                           Visibility="{x:Bind ViewModel.ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                                <TextBlock Text="Loading..." 
                                           Visibility="{x:Bind ViewModel.IsFileLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <ProgressBar IsIndeterminate="True" 
                                             Width="100" 
                                             Visibility="{x:Bind ViewModel.IsFileLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="Saving..." 
                                           Visibility="{x:Bind ViewModel.IsFileSaving, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <ProgressBar IsIndeterminate="True" 
                                             Width="100" 
                                             Visibility="{x:Bind ViewModel.IsFileSaving, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="8">
                                <Button Content="Create New File" Click="CreateNewFile_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
