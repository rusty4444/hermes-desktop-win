<Application
    x:Class="HermesDesktop.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HermesDesktop.WinUI"
    xmlns:converters="using:HermesDesktop.WinUI.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <x:String x:Key="AppName">Hermes Desktop</x:String>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibilityConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:DateTimeToStringConverter x:Key="DateTimeToStringConverter"/>
            <converters:FilterCardsByLaneConverter x:Key="FilterCardsByLaneConverter"/>
            <converters:ListToStringConverter x:Key="ListToStringConverter"/>
            <converters:BoolToSymbolConverter x:Key="BoolToSymbolConverter"/>
            <converters:ChatRoleToBrushConverter x:Key="ChatRoleToBrushConverter"/>
            <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
            <converters:BoolToBrushConverter x:Key="BoolToBrushConverter"/>

            <!-- Aliases for Views that use different key names -->
            <converters:DateTimeToStringConverter x:Key="TimestampToStringConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToStringConverter"/>
            <converters:ChatRoleToBrushConverter x:Key="RoleToBackgroundConverter"/>

            <!-- Accent Button Style -->
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundAccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="{ThemeResource SystemControlBackgroundAccentBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
